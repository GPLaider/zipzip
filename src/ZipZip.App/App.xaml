<Application
    x:Class="ZipZip.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ZipZipWindowBackgroundBrush" Color="#FFF1F3F6" />
                    <SolidColorBrush x:Key="ZipZipSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ZipZipSurfaceMutedBrush" Color="#FFF7F8FA" />
                    <SolidColorBrush x:Key="ZipZipSurfaceStrongBrush" Color="#FFEAF0F6" />
                    <SolidColorBrush x:Key="ZipZipToolbarBrush" Color="#FFF4F6F8" />
                    <SolidColorBrush x:Key="ZipZipPanelHeaderBrush" Color="#FFF6F7F9" />
                    <SolidColorBrush x:Key="ZipZipStrokeBrush" Color="#FFC8D0D8" />
                    <SolidColorBrush x:Key="ZipZipMutedForegroundBrush" Color="#FF5D6772" />
                    <SolidColorBrush x:Key="ZipZipBrandBrush" Color="#FF0F6CBD" />
                    <SolidColorBrush x:Key="ZipZipBrandStrongBrush" Color="#FF0B5CA5" />
                    <SolidColorBrush x:Key="ZipZipOnBrandBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ZipZipBrandSubtleBrush" Color="#FFDCEBFA" />
                    <SolidColorBrush x:Key="ZipZipSuccessSubtleBrush" Color="#FFE9F6EC" />
                    <SolidColorBrush x:Key="ZipZipSuccessForegroundBrush" Color="#FF156C2F" />
                    <SolidColorBrush x:Key="ZipZipHeroForegroundBrush" Color="#FF1F2933" />
                    <SolidColorBrush x:Key="ZipZipHeroMutedForegroundBrush" Color="#FF5D6772" />
                    <SolidColorBrush x:Key="ZipZipHeroOverlayBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ZipZipHeroOverlayStrongBrush" Color="#FFEAF0F6" />
                    <SolidColorBrush x:Key="ZipZipHeroStrokeBrush" Color="#FFC8D0D8" />
                    <SolidColorBrush x:Key="ZipZipHeroBrush" Color="#FFF4F6F8" />
                    <SolidColorBrush x:Key="ZipZipToolStripBrush" Color="#FF0F6CBD" />
                    <SolidColorBrush x:Key="ZipZipToolStripForegroundBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ZipZipWindowBackgroundBrush" Color="#FF161A1F" />
                    <SolidColorBrush x:Key="ZipZipSurfaceBrush" Color="#FF1F242B" />
                    <SolidColorBrush x:Key="ZipZipSurfaceMutedBrush" Color="#FF252C35" />
                    <SolidColorBrush x:Key="ZipZipSurfaceStrongBrush" Color="#FF1C2732" />
                    <SolidColorBrush x:Key="ZipZipToolbarBrush" Color="#FF1B2027" />
                    <SolidColorBrush x:Key="ZipZipPanelHeaderBrush" Color="#FF222933" />
                    <SolidColorBrush x:Key="ZipZipStrokeBrush" Color="#FF39424D" />
                    <SolidColorBrush x:Key="ZipZipMutedForegroundBrush" Color="#FFB6C0CB" />
                    <SolidColorBrush x:Key="ZipZipBrandBrush" Color="#FF67B3FF" />
                    <SolidColorBrush x:Key="ZipZipBrandStrongBrush" Color="#FF90C9FF" />
                    <SolidColorBrush x:Key="ZipZipOnBrandBrush" Color="#FF102033" />
                    <SolidColorBrush x:Key="ZipZipBrandSubtleBrush" Color="#FF12314A" />
                    <SolidColorBrush x:Key="ZipZipSuccessSubtleBrush" Color="#FF213727" />
                    <SolidColorBrush x:Key="ZipZipSuccessForegroundBrush" Color="#FF97D8A8" />
                    <SolidColorBrush x:Key="ZipZipHeroForegroundBrush" Color="#FFF3F5F7" />
                    <SolidColorBrush x:Key="ZipZipHeroMutedForegroundBrush" Color="#FFB6C0CB" />
                    <SolidColorBrush x:Key="ZipZipHeroOverlayBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ZipZipHeroOverlayStrongBrush" Color="#FF25303B" />
                    <SolidColorBrush x:Key="ZipZipHeroStrokeBrush" Color="#FF39424D" />
                    <SolidColorBrush x:Key="ZipZipHeroBrush" Color="#FF1B2027" />
                    <SolidColorBrush x:Key="ZipZipToolStripBrush" Color="#FF0D558C" />
                    <SolidColorBrush x:Key="ZipZipToolStripForegroundBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ZipZipPanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ZipZipSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ZipZipStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="ZipZipToolbarBorderStyle" TargetType="Border" BasedOn="{StaticResource ZipZipPanelBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource ZipZipToolbarBrush}" />
            </Style>

            <Style x:Key="ZipZipPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource ZipZipBrandBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ZipZipOnBrandBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ZipZipBrandBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="ZipZipSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource ZipZipSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ZipZipStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="ZipZipCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipSecondaryButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="58" />
            </Style>

            <Style x:Key="ZipZipChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipSecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="72" />
            </Style>

            <Style x:Key="ZipZipChoiceButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource ZipZipChoiceButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ZipZipBrandSubtleBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ZipZipBrandStrongBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ZipZipBrandBrush}" />
            </Style>

            <Style x:Key="ZipZipToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipSecondaryButtonStyle}">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ZipZipToolStripButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="MinWidth" Value="70" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource ZipZipToolStripForegroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ZipZipHeroButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipSecondaryButtonStyle}" />

            <Style x:Key="ZipZipHeroPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipPrimaryButtonStyle}" />

            <Style x:Key="ZipZipBreadcrumbButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="4,1" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="ZipZipSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ZipZipCaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ZipZipMutedForegroundBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style x:Key="ZipZipTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Background" Value="{ThemeResource ZipZipSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ZipZipStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="ZipZipPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Background" Value="{ThemeResource ZipZipSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ZipZipStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
