<Page
    x:Class="ZipZip.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ZipZip.App.ViewModels"
    Background="{ThemeResource ZipZipWindowBackgroundBrush}" KeyboardAcceleratorPlacementMode="Hidden">
    <Page.Resources>
        <Style x:Key="HomeCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipSecondaryButtonStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="MinHeight" Value="108" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="HomePrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource HomeCommandButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource ZipZipBrandStrongBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ZipZipOnBrandBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ZipZipBrandStrongBrush}" />
        </Style>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteKeyboardAcceleratorInvoked" />
    </Page.KeyboardAccelerators>
    <Page.DataContext>
        <viewModels:HomeViewModel />
    </Page.DataContext>

    <Grid Padding="24" RowSpacing="20" AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="52" Height="52" Source="ms-appx:///Assets/App/ZipZip.png" AutomationProperties.Name="ZipZip" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="ZipZip" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="파일은 가볍게, 작업은 간편하게." Style="{StaticResource ZipZipCaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="2" Click="OnSettingsClick" Content="설정" VerticalAlignment="Center" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="OnOpenArchiveClick" AutomationProperties.Name="압축 파일 열기" ToolTipService.ToolTip="압축 파일 열기 · Ctrl+O" Style="{StaticResource HomePrimaryCommandButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8E5;" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="압축 파일 열기" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="내용 확인부터 압축 풀기까지" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Grid.Column="1" Click="OnCreateArchiveClick" AutomationProperties.Name="새로 압축하기" ToolTipService.ToolTip="새로 압축하기 · Ctrl+N" Style="{StaticResource HomeCommandButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE898;" FontSize="28" VerticalAlignment="Center" Foreground="{ThemeResource ZipZipBrandBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="새로 압축하기" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="파일을 모아 ZIP 또는 7Z로" FontSize="12" Style="{StaticResource ZipZipCaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="최근 압축 파일" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RecentArchiveCountLabel}" VerticalAlignment="Center" Style="{StaticResource ZipZipCaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Click="OnCreateFolderClick" Content="폴더 압축…" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ZipZipPanelBorderStyle}">
            <Grid>
                <ListView ItemClick="OnRecentItemClick" IsItemClickEnabled="True" ItemsSource="{Binding RecentArchives}" SelectionMode="None" AutomationProperties.Name="최근 압축 파일">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="64" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:RecentArchiveItem">
                            <Border Padding="16,12" ToolTipService.ToolTip="{x:Bind FullPath}">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnRemoveRecentItemClick" Tag="{x:Bind FullPath}" Text="기록에서 제거" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="32" Height="32" Source="{x:Bind IconSource}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FullPath}" FontSize="12" Foreground="{ThemeResource ZipZipMutedForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind FormatLabel}" FontSize="12" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind LastOpenedLabel}" FontSize="12" Style="{StaticResource ZipZipCaptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Margin="24" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyRecentVisibility}" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource ZipZipBrandBrush}" />
                    <TextBlock Text="여기에 파일을 놓아보세요" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="압축 파일은 열고, 일반 파일과 폴더는 새로 압축합니다.&#xA;열었던 압축 파일은 이곳에 표시됩니다." Style="{StaticResource ZipZipCaptionStyle}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <InfoBar x:Name="HomeStatusInfoBar" Grid.Row="4" IsClosable="True" IsOpen="False" Severity="Informational" />
    </Grid>
</Page>
