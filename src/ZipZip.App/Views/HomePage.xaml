<Page
    x:Class="ZipZip.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ZipZip.App.ViewModels"
    Background="{ThemeResource ZipZipWindowBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="HomeCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipSecondaryButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="HomePrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ZipZipPrimaryButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="V"
            Modifiers="Control"
            Invoked="OnPasteKeyboardAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <Page.DataContext>
        <viewModels:HomeViewModel />
    </Page.DataContext>

    <Grid
        Padding="8"
        AllowDrop="True"
        ColumnSpacing="10"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Column="0"
            Padding="0"
            Style="{StaticResource ZipZipPanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="10,6"
                    Background="{ThemeResource ZipZipPanelHeaderBrush}"
                    BorderBrush="{ThemeResource ZipZipStrokeBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{StaticResource ZipZipSectionTitleStyle}"
                            Text="빠른 작업" />

                        <Button
                            Grid.Column="1"
                            Click="OnSettingsClick"
                            Content="설정"
                            Style="{StaticResource ZipZipToolbarButtonStyle}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Padding="10" Spacing="8">
                    <Button
                        Click="OnOpenArchiveClick"
                        Style="{StaticResource HomePrimaryCommandButtonStyle}">
                        <Grid Padding="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Glyph="&#xE8E5;" />

                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="압축 파일 열기" />

                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xE72A;" />
                        </Grid>
                    </Button>

                    <Button
                        Click="OnCreateArchiveClick"
                        Style="{StaticResource HomeCommandButtonStyle}">
                        <Grid Padding="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Glyph="&#xE898;" />

                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="새로 압축하기" />

                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xE72A;" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Padding="0"
            Style="{StaticResource ZipZipPanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="10,6"
                    Background="{ThemeResource ZipZipPanelHeaderBrush}"
                    BorderBrush="{ThemeResource ZipZipStrokeBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{StaticResource ZipZipSectionTitleStyle}"
                            Text="최근 압축 파일" />

                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ZipZipCaptionStyle}"
                            FontSize="11.5"
                            Text="{Binding RecentArchiveCountLabel}" />
                    </Grid>
                </Border>

                <ListView
                    Grid.Row="1"
                    ItemClick="OnRecentItemClick"
                    IsItemClickEnabled="True"
                    ItemsSource="{Binding RecentArchives}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="42" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:RecentArchiveItem">
                            <Border
                                Padding="10,6"
                                BorderBrush="{ThemeResource ZipZipStrokeBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="OnRemoveRecentItemClick"
                                            Tag="{x:Bind FullPath}"
                                            Text="기록에서 제거" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind IconSource}"
                                        Stretch="Uniform" />

                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource ZipZipCaptionStyle}"
                                            FontSize="11"
                                            Text="{x:Bind FullPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="1">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind FormatLabel}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource ZipZipCaptionStyle}"
                                            FontSize="11"
                                            Text="{x:Bind LastOpenedLabel}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <InfoBar
            x:Name="HomeStatusInfoBar"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,6,0,0"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />
    </Grid>
</Page>
