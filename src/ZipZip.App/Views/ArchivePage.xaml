<Page
    x:Class="ZipZip.App.Views.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ZipZip.App.ViewModels"
    Background="{ThemeResource ZipZipWindowBackgroundBrush}">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="C"
            Modifiers="Control"
            Invoked="OnCopyKeyboardAcceleratorInvoked" />
        <KeyboardAccelerator
            Key="V"
            Modifiers="Control"
            Invoked="OnPasteKeyboardAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <Page.DataContext>
        <viewModels:ArchiveViewModel />
    </Page.DataContext>

    <Grid
        Padding="8"
        AllowDrop="True"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource ZipZipToolStripBrush}"
            BorderBrush="{ThemeResource ZipZipStrokeBrush}"
            BorderThickness="1">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button
                        Click="OnOpenArchiveClick"
                        Style="{StaticResource ZipZipToolStripButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="열기" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnExtractClick"
                        Style="{StaticResource ZipZipToolStripButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                            <FontIcon FontSize="16" Glyph="&#xE896;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="풀기" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnCreateArchiveClick"
                        Style="{StaticResource ZipZipToolStripButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                            <FontIcon FontSize="16" Glyph="&#xE898;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="새 압축" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Row="2"
            Padding="8,5"
            Style="{StaticResource ZipZipToolbarBorderStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Text="{Binding ArchiveName}" />

                    <Border
                        Padding="6,1"
                        Background="{ThemeResource ZipZipBrandSubtleBrush}"
                        BorderBrush="{ThemeResource ZipZipBrandBrush}"
                        BorderThickness="1">
                        <TextBlock
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ZipZipBrandStrongBrush}"
                            Text="{Binding FormatLabel}" />
                    </Border>

                    <TextBlock
                        Style="{StaticResource ZipZipCaptionStyle}"
                        FontSize="11"
                        Text="{Binding EntrySummary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource ZipZipCaptionStyle}"
                        FontSize="11"
                        Text="{Binding SelectionSummary}" />

                    <Button
                        Click="OnExtractSelectedClick"
                        Content="선택 풀기"
                        Style="{StaticResource ZipZipToolbarButtonStyle}" />

                    <Button
                        Click="OnNavigateUpClick"
                        Content="위로"
                        IsEnabled="{Binding CanNavigateUpFolder}"
                        Style="{StaticResource ZipZipToolbarButtonStyle}" />

                    <Button
                        Click="OnHomeClick"
                        Content="홈"
                        Style="{StaticResource ZipZipToolbarButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Padding="8,4"
            Style="{StaticResource ZipZipPanelBorderStyle}">
            <ItemsControl ItemsSource="{Binding BreadcrumbSegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:BreadcrumbSegmentViewModel">
                        <Button
                            Click="OnBreadcrumbClick"
                            Style="{StaticResource ZipZipBreadcrumbButtonStyle}"
                            Tag="{x:Bind Path}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon FontSize="8" Glyph="&#xE76C;" />
                                <TextBlock FontSize="11" Text="{x:Bind Label}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <InfoBar
                Grid.Column="0"
                IsClosable="False"
                IsOpen="{Binding HasOperationMessage}"
                Message="{Binding OperationMessage}"
                Severity="{Binding OperationSeverity}" />

            <Button
                Grid.Column="1"
                MinWidth="96"
                Command="{Binding OpenCompletedFolderCommand}"
                Content="폴더 열기"
                Style="{StaticResource ZipZipPrimaryButtonStyle}"
                Visibility="{Binding CompletedFolderActionVisibility}" />
        </Grid>

        <Border
            Grid.Row="8"
            Padding="0"
            Style="{StaticResource ZipZipPanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="8,5"
                    Background="{ThemeResource ZipZipPanelHeaderBrush}"
                    BorderBrush="{ThemeResource ZipZipStrokeBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="이름" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Text="압축 크기" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Text="원본 크기" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Text="파일 종류" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="8,4"
                    Background="{ThemeResource ZipZipSurfaceBrush}"
                    BorderBrush="{ThemeResource ZipZipStrokeBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding LoadingVisibility}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ProgressRing Width="12" Height="12" IsActive="{Binding IsLoading}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource ZipZipCaptionStyle}"
                            FontSize="11"
                            Text="압축 파일 내용을 불러오는 중입니다." />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListView
                        x:Name="EntriesListView"
                        Background="Transparent"
                        BorderThickness="0"
                        DoubleTapped="OnEntriesDoubleTapped"
                        ItemsSource="{Binding Entries}"
                        SelectionChanged="OnEntriesSelectionChanged"
                        SelectionMode="Extended">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ArchiveEntryItemViewModel">
                                <Border
                                    Padding="8,4"
                                    BorderBrush="{ThemeResource ZipZipStrokeBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="16" Height="16">
                                                <Border
                                                    Width="16"
                                                    Height="16"
                                                    Background="{x:Bind IconBackground}"
                                                    CornerRadius="0"
                                                    Visibility="{x:Bind GlyphIconVisibility}">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="9"
                                                        Foreground="{x:Bind IconForeground}"
                                                        Glyph="{x:Bind IconGlyph}" />
                                                </Border>

                                                <Image
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind ArchiveIconSource}"
                                                    Stretch="Uniform"
                                                    Visibility="{x:Bind ArchiveIconVisibility}" />
                                            </Grid>

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Text="{x:Bind PackedSizeText}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Text="{x:Bind OriginalSizeText}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Text="{x:Bind TypeLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Padding="10"
                        Background="#33C42B1C"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Margin="8"
                        Visibility="{Binding ErrorVisibility}">
                        <TextBlock
                            Foreground="#FF8A1010"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="WrapWholeWords" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
