<Page x:Class="ZipZip.App.Views.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ZipZip.App.ViewModels"
    Background="{ThemeResource ZipZipWindowBackgroundBrush}" KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyKeyboardAcceleratorInvoked" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteKeyboardAcceleratorInvoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindKeyboardAcceleratorInvoked" />
    </Page.KeyboardAccelerators>
    <Grid Padding="24" RowSpacing="14" AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="40" Height="40" Source="{Binding FormatIconSource}" />
            <StackPanel Grid.Column="1" Spacing="4" ToolTipService.ToolTip="{Binding ArchivePathDisplay}">
                <TextBlock Text="{Binding ArchiveName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding FormatLabel}" Foreground="{ThemeResource ZipZipBrandBrush}" />
                    <TextBlock Text="{Binding EntrySummary}" Style="{StaticResource ZipZipCaptionStyle}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Click="OnHomeClick" Content="홈" VerticalAlignment="Center" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnExtractClick" Content="전체 풀기" IsEnabled="{Binding CanExtract}" Style="{StaticResource ZipZipPrimaryButtonStyle}" />
                <Button Click="OnExtractSelectedClick" Content="선택 풀기" IsEnabled="{Binding CanExtractSelected}" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
                <Button Click="OnTestArchiveClick" Content="무결성 검사" IsEnabled="{Binding CanExtract}" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
                <Button Click="OnOpenArchiveClick" Content="다른 파일 열기" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
                <Button Click="OnCreateArchiveClick" Content="새 압축" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="OnNavigateUpClick" Content="위로" IsEnabled="{Binding CanNavigateUpFolder}" Style="{StaticResource ZipZipSecondaryButtonStyle}" />
            <Border Grid.Column="1" Padding="8,2" Style="{StaticResource ZipZipPanelBorderStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <ItemsControl ItemsSource="{Binding BreadcrumbSegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BreadcrumbSegmentViewModel">
                                <Button Click="OnBreadcrumbClick" Style="{StaticResource ZipZipBreadcrumbButtonStyle}" Tag="{x:Bind Path}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="10" Glyph="&#xE76C;" />
                                        <TextBlock FontSize="13" Text="{x:Bind Label}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="현재 폴더에서 찾기 (Ctrl+F)" AutomationProperties.Name="현재 폴더에서 파일 이름 찾기"
                    KeyDown="OnSearchKeyDown" Style="{StaticResource ZipZipTextBoxStyle}" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="파일 목록 정렬">
                    <ComboBoxItem Content="이름 오름차순" /><ComboBoxItem Content="이름 내림차순" />
                    <ComboBoxItem Content="큰 파일 먼저" /><ComboBoxItem Content="작은 파일 먼저" />
                </ComboBox>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ZipZipPanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="16,12" Background="{ThemeResource ZipZipPanelHeaderBrush}" BorderBrush="{ThemeResource ZipZipStrokeBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="이름" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="압축 크기" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="원본 크기" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="파일 종류" FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{Binding LoadingVisibility}" />
                <ListView x:Name="EntriesListView" Grid.Row="2" AutomationProperties.Name="압축 파일 내용" Background="Transparent" BorderThickness="0"
                    DoubleTapped="OnEntriesDoubleTapped" ItemsSource="{Binding Entries}" SelectionChanged="OnEntriesSelectionChanged" SelectionMode="Extended"
                    ContainerContentChanging="OnEntryContainerContentChanging">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ArchiveEntryItemViewModel">
                            <Border Padding="16,10" ToolTipService.ToolTip="{x:Bind InternalPath}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="20" Height="20">
                                            <FontIcon FontSize="18" Foreground="{ThemeResource ZipZipBrandBrush}" Glyph="{x:Bind IconGlyph}" Visibility="{x:Bind GlyphIconVisibility}" />
                                            <Image Source="{x:Bind ArchiveIconSource}" Visibility="{x:Bind ArchiveIconVisibility}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind PackedSizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind OriginalSizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind TypeLabel}" VerticalAlignment="Center" Foreground="{ThemeResource ZipZipMutedForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="{Binding EmptyMessage}" Visibility="{Binding EmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" Foreground="{ThemeResource ZipZipMutedForegroundBrush}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding FooterSummary}" Style="{StaticResource ZipZipCaptionStyle}" />
        <StackPanel Grid.Row="5" Spacing="8">
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding ErrorMessage}" />
            <InfoBar IsOpen="{Binding HasOperationMessage}" Severity="{Binding OperationSeverity}" IsClosable="False" Message="{Binding OperationMessage}">
                <InfoBar.ActionButton>
                    <Button Command="{Binding OpenCompletedFolderCommand}" Content="폴더 열기" Visibility="{Binding CompletedFolderActionVisibility}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </Grid>
</Page>
